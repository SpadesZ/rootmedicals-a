# RootMedicals-A — DEV (local) environment profile.
# Source of truth for LOCAL development.
# Activate with:   .\Use-Environment.ps1 -Profile dev
# The switch script copies this file to ./.env (which docker-compose reads).
#
# Secrets do NOT belong here. LLMEBM_TOPIC_GENERATION_TOKEN and provider API
# keys stay in .env.topic / the LAVA settings store. Both are gitignored.

# Label only (not read by code; handy for logs / eyeballing which profile is live).
ROOTMEDICALS_ENV=local
ROOTMEDICALS_HOST=127.0.0.1

# Local demo toggles.
LLMXX_CLIENT_DEMO_FIXTURE_ENABLED=true
ROOTMEDICALS_ALERT_THEME=clinical

# llmxx-server -> ebm-rag LAVA task API (host-run ebm-rag on 33301).
LLMXX_RAG_BASE_URL=http://127.0.0.1:33301
LLMXX_LAVA_TASK_BASE_URL=http://127.0.0.1:33301/api/lava/tasks
# Short timeout is fine locally (fixture / fast LAVA). VM uses a longer one.
LLMXX_LAVA_TIMEOUT_SECONDS=2

# llmebm (Docker) -> host-run ebm-rag stack via Docker Desktop's host gateway.
# If you run llmebm DIRECTLY on the host (llmebm/.venv), use http://127.0.0.1:33301 instead.
EBM_RAG_BASE_URL=http://host.docker.internal:33301

# Legacy placeholders kept so the compose env_file surface stays stable.
# Real secrets go in .env.topic / LAVA settings, not here.
LLM_API_KEY=
DB_PASSWORD=
