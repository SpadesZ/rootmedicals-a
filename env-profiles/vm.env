# RootMedicals-A — VM (delivery) environment profile.
# Source of truth for the VM / hand-off build.
# Activate with:   .\Use-Environment.ps1 -Profile vm
# The switch script copies this file to ./.env (which docker-compose reads).
#
# Secrets do NOT belong here. LLMEBM_TOPIC_GENERATION_TOKEN and provider API
# keys stay in .env.topic / the LAVA settings store on the VM. Both are gitignored.
#
# ⚠️  Values marked  # CONFIRM  depend on how the VM wires its services and must
#     be verified before delivery. They currently mirror the working dev values
#     so behaviour does not silently break if left as-is.

# Label only (not read by code).
ROOTMEDICALS_ENV=vm
ROOTMEDICALS_HOST=0.0.0.0

# Delivery runs live, not the local fixture loop. Flip to true only for a
# fixture-based demo build.
LLMXX_CLIENT_DEMO_FIXTURE_ENABLED=false
ROOTMEDICALS_ALERT_THEME=clinical

# llmxx-server -> ebm-rag LAVA task API.
# CONFIRM: on a Linux VM these must point at wherever ebm-rag actually listens
# (same-host 127.0.0.1:33301, a compose service name, or the VM's internal IP).
LLMXX_RAG_BASE_URL=http://127.0.0.1:33301                              # CONFIRM
LLMXX_LAVA_TASK_BASE_URL=http://127.0.0.1:33301/api/lava/tasks         # CONFIRM
# Real network LLM calls need more headroom than the local fixture path.
LLMXX_LAVA_TIMEOUT_SECONDS=30

# llmebm -> ebm-rag.
# CONFIRM: `host.docker.internal` resolves on Docker Desktop but NOT by default
# on a plain Linux Docker host. On the VM, use the ebm-rag container/service
# address (e.g. http://ebm-rag-engine:8000) or add a host-gateway mapping.
EBM_RAG_BASE_URL=http://host.docker.internal:33301                     # CONFIRM

# Legacy placeholders kept so the compose env_file surface stays stable.
LLM_API_KEY=
DB_PASSWORD=
