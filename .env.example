# RootMedicals-A local demo environment.
# Copy to .env and fill local-only values. Do not commit .env.

ROOTMEDICALS_ENV=local
ROOTMEDICALS_HOST=127.0.0.1

# Optional local demo toggles.
LLMXX_CLIENT_DEMO_FIXTURE_ENABLED=true
ROOTMEDICALS_ALERT_THEME=clinical

# Optional LAVA/RAG integration settings.
LLMXX_RAG_BASE_URL=http://127.0.0.1:33301
LLMXX_LAVA_TASK_BASE_URL=http://127.0.0.1:33301/api/lava/tasks
LLMXX_LAVA_TIMEOUT_SECONDS=2

# Provider/API keys belong in the local LAVA settings or secret store, not here.
