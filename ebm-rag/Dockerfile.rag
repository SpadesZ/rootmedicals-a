# 檔案路徑: rootmedicals-a/ebm-rag/Dockerfile.rag
# 產生時間: 2026-06-17 16:10 +08:00
# 版本: v0.1-交付整理
# 說明: EBM-RAG 服務入口、Docker 設定、文件或依賴描述。
# 交付: 保留於交付包；若未來刪除，需先確認閉環 demo 與對應文件不再依賴。
# ----------------------------------------------------------------------------------------------------

# File Path: ebm-rag/Dockerfile.rag
# Timestamp: 2026-06-09
# Version: v0.4
# Description: EBM-RAG FastAPI container image.
#              Uses Python 3.10 slim with PDF/OCR system libraries and project requirements.
# ----------------------------------------------------------------------------------------------------
FROM python:3.10-slim

# 設定工作目錄
WORKDIR /app

# 安裝系統級影像處理依賴 (必要組件：支援 PDF2Image 與 OpenCV)
# 採用 libgl1 替代舊版 libgl1-mesa-glx 以相容最新版 Debian 基礎映像檔
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# 預先複製並安裝 Python 依賴
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 複製全量專案代碼 (包含 rag_core 與 app 目錄)
COPY . .

# 設定環境變數，確保 Python 輸出不被快取，利於日誌監控與除錯
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV YOLO_CONFIG_DIR=/tmp/Ultralytics

RUN mkdir -p /tmp/Ultralytics && chmod 1777 /tmp/Ultralytics

# 啟動命令：使用 Uvicorn 運行 RAG 主路由服務
CMD ["uvicorn", "main_rag:app", "--host", "0.0.0.0", "--port", "8000"]
